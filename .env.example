# =============================================================================
# PLANTILLA DE VARIABLES DE ENTORNO
# Proyecto Semestral - Seguridad en los Sistemas de Informacion - UTP FISC
# -----------------------------------------------------------------------------
# COMO USAR ESTE ARCHIVO
#
# cp .env.example .env
# nano .env # completar TODOS los valores marcados como CAMBIAR
# chmod 600 .env # solo el propietario puede leerlo
#
# ESTE archivo (.env.example) SI se versiona en Git: documenta que variables
# existen y para que sirven.
#
# EL archivo .env NUNCA se versiona. Esta declarado en .gitignore.
#
# POR QUE SE HACE ASI
# -------------------
# El perfil del proyecto exige que WordPress use variables de entorno para sus
# datos de configuracion. La razon de seguridad es la separacion entre codigo y
# credenciales:
#
# * El codigo y la configuracion son publicos y auditables por el equipo.
# * Los secretos viven unicamente en el servidor donde se ejecutan.
# * Rotar una contrasena comprometida no requiere modificar ni reconstruir
# la aplicacion, solo reiniciar los contenedores.
# * Se elimina el riesgo mas frecuente de fuga de credenciales: subirlas al
# repositorio por descuido. Una contrasena publicada en Git queda en el
# historial para siempre, aunque se borre en un commit posterior.
# =============================================================================
# -----------------------------------------------------------------------------
# BASE DE DATOS
# -----------------------------------------------------------------------------
# IMPORTANTE: el valor de MYSQL_DATABASE debe coincidir con el parametro
# binlog_do_db definido en mariadb/primary.cnf. Si se cambia aqui, hay que
# cambiarlo tambien alli o la replicacion no transportara ningun dato.
# -----------------------------------------------------------------------------
MYSQL_DATABASE=wordpress_db
MYSQL_USER=wp_usuario
# CAMBIAR. Generar con: openssl rand -base64 32
MYSQL_PASSWORD=CAMBIAR_contrasena_larga_y_aleatoria
MYSQL_ROOT_PASSWORD=CAMBIAR_contrasena_root_distinta_de_la_anterior
# Prefijo de las tablas de WordPress.
# Se cambia el valor por defecto "wp_" porque muchos exploits automatizados de
# inyeccion SQL asumen ese prefijo y construyen consultas contra wp_users
# directamente. No es una defensa fuerte, pero rompe la explotacion enlatada.
WP_TABLE_PREFIX=sec_
# -----------------------------------------------------------------------------
# USUARIO DE REPLICACION
# -----------------------------------------------------------------------------
# Cuenta separada, con el unico privilegio REPLICATION SLAVE.
REPL_USER=repl_usuario
REPL_PASSWORD=CAMBIAR_contrasena_de_replicacion
# -----------------------------------------------------------------------------
# CACHE REDIS
# -----------------------------------------------------------------------------
# Redis sin contrasena es una de las causas mas comunes de compromiso en
# servidores expuestos. Aunque aqui vive en una red interna sin salida, se
# protege igual: defensa en profundidad.
REDIS_PASSWORD=CAMBIAR_contrasena_de_redis
# -----------------------------------------------------------------------------
# DIRECCION PUBLICA DEL SITIO
# -----------------------------------------------------------------------------
# Debe incluir el prefijo https:// y la IP publica actual de la instancia EC2.
#
# RECORDATORIO SOBRE AWS ACADEMY LEARNER LAB: al detener el laboratorio la
# instancia se apaga y recibe una IP publica distinta al reiniciarla. Hay que
# actualizar este valor al inicio de cada sesion, salvo que se tenga asociada
# una Elastic IP.
#
# Para obtener la IP actual desde la propia instancia:
# TOKEN=$(curl -sX PUT "http://169.254.169.254/latest/api/token" \
# -H "X-aws-ec2-metadata-token-ttl-seconds: 300")
# curl -s -H "X-aws-ec2-metadata-token: $TOKEN" \
# http://169.254.169.254/latest/meta-data/public-ipv4
# -----------------------------------------------------------------------------
WP_URL=https://CAMBIAR_IP_PUBLICA
# -----------------------------------------------------------------------------
# CERTIFICADO TLS
# -----------------------------------------------------------------------------
CERT_BITS=4096
CERT_DAYS=365
CERT_PAIS=PA
CERT_ORG=UTP-FISC
# Dejar VACIO para que el script detecte la IP automaticamente via IMDSv2.
# Rellenar unicamente si se dispone de una Elastic IP fija.
CERT_IP_MANUAL=
# -----------------------------------------------------------------------------
# IMAGEN DE LA APLICACION
# -----------------------------------------------------------------------------
# En desarrollo local se construye desde el Dockerfile.
# En despliegue por CI/CD se apunta a la imagen publicada en el registro:
# IMAGEN_WORDPRESS=ghcr.io/<usuario>/<repositorio>-wp:latest
IMAGEN_WORDPRESS=proyecto-seguridad-wp:local
# -----------------------------------------------------------------------------
# SALES DE AUTENTICACION DE WORDPRESS
# -----------------------------------------------------------------------------
# Cadenas aleatorias que WordPress usa para firmar las cookies de sesion y los
# nonces de los formularios.
#
# Su funcion de seguridad: sin ellas, las cookies de autenticacion serian
# predecibles y un atacante podria falsificar una sesion de administrador sin
# conocer ninguna contrasena.
#
# Deben ser IDENTICAS en los dos contenedores WordPress. Si difieren, una sesion
# iniciada a traves de wp1 seria rechazada al ser atendida por wp2 y el usuario
# quedaria desconectado de forma intermitente y aparentemente aleatoria.
#
# Generar los ocho valores de una sola vez en:
# https://api.wordpress.org/secret-key/1.1/salt/
# -----------------------------------------------------------------------------
WP_AUTH_KEY=CAMBIAR
WP_SECURE_AUTH_KEY=CAMBIAR
WP_LOGGED_IN_KEY=CAMBIAR
WP_NONCE_KEY=CAMBIAR
WP_AUTH_SALT=CAMBIAR
WP_SECURE_AUTH_SALT=CAMBIAR
WP_LOGGED_IN_SALT=CAMBIAR
WP_NONCE_SALT=CAMBIAR
